# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# PostgreSQL Connection String for Prisma ORM
DATABASE_URL="postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require"
